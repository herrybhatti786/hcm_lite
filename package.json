{
  "name": "hcm-lite",
  "version": "1.0.0",
  "description": "HCM Lite - AI-assisted Human Capital Management for Admin, HR, and Employees",
  "main": "api/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "setup": "cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm install --include=dev && npm run build",
    "start": "cd backend && node src/index.js",
    "dev:backend": "cd backend && node src/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "db:reset": "cd backend && node src/db/resetDb.js",
    "test": "node tests/runAllTests.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "geolib": "^3.3.4",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sql.js": "^1.12.0"
  },
  "keywords": [
    "hcm",
    "hr",
    "payroll",
    "ai",
    "gsap",
    "attendance"
  ],
  "author": "Saylani Hackathon Team",
  "license": "ISC"
}
